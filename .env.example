# Everything here is optional. With none of it set the system still runs the
# free collectors (ATS, techstack, EDGAR, HN, Lobsters) and scores accounts.

# Railway: mount a volume at /data and set this so SQLite survives redeploys.
DATA_DIR=/data

# Shared secret for the hosted UI. Visit /?key=... once, it sets a cookie.
UI_KEY=

# GitHub: raises the API limit from 60/hr to 5,000/hr. Free.
GITHUB_TOKEN=

# Email verification. Pay-as-you-go credits, never expire. ~$39 / 10k.
MILLIONVERIFIER_KEY=

# People Data Labs. Free tier = 100 lookups/month; only called for accounts
# that already pass the fit gates, which is what keeps it inside the free tier.
PDL_KEY=

# Intent classification. Prefiltered + cached, so spend stays at a few $/month.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Reddit's free tier is NON-COMMERCIAL — also gated off in malveon.yaml.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Set to 1 to run the web UI without the background scheduler.
DISABLE_SCHEDULER=
